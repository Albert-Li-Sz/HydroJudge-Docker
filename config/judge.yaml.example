# Copy to config/judge.yaml and replace the site address and credentials.
# The account must have PRIV_JUDGE permission on the Hydro site.
hosts:
  main:
    type: hydro
    server_url: https://oj.example.com/
    uname: judge
    password: REPLACE_AT_RUNTIME
    detail: full
    concurrency: 2
    # Only accept languages actually installed in this image.
    # Confirm the keys against your site's language configuration.
    # The '_' key is used for objective and submit-answer tasks.
    lang: ['_', c, cc, cc.cc98, cc.cc98o2, cc.cc11, cc.cc11o2, cc.cc14, cc.cc14o2, cc.cc17, cc.cc17o2, cc.cc20, cc.cc20o2, java, py.py3, py.pypy3]

parallelism: 2
singleTaskParallelism: 2
memoryMax: 1024m
stdio_size: 256m
processLimit: 128
testcases_max: 120
total_time_limit: 600
rerun: 2
rate: 1
cache_dir: /var/cache/hydrojudge
tmp_dir: /tmp/hydrojudge
env: |
  PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
  HOME=/w
  LANG=C.UTF-8
